#!/usr/bin/env bash
#
# pre-push hook: on a push to master, ask (via a real Windows GUI dialog, not
# terminal input) whether to cut a new beta release tag. If yes, prompts for
# the tag name and a commit message, then:
#   - bumps pubspec.yaml's `version:` line
#   - bumps lib/config/version.dart's preRelease + buildNumber to match
#     (these two currently drift independently - this keeps them locked
#     together automatically, which the manual checklist didn't enforce)
#   - commits those two files
#   - creates an annotated tag and pushes it
#   - lets your original push (the branch itself) continue normally
#
# WHY GUI DIALOGS INSTEAD OF TERMINAL PROMPTS:
# Git hooks triggered from Android Studio's VCS push button don't reliably
# get a real interactive terminal - a `read` prompt can hang or be silently
# skipped depending on IDE/OS/git version. A native Win32 dialog box doesn't
# need a TTY at all, so it works the same whether you push from the IDE
# button or a terminal. If you're not on Windows, see the NON-WINDOWS
# FALLBACK note near the bottom - you'll want zenity/osascript instead of
# the powershell.exe calls below.
#
# SETUP (one-time, see also tools/git-hooks/README.md if you keep one):
#   1. This file should live at tools/git-hooks/pre-push in the repo (already
#      tracked in git) rather than .git/hooks/pre-push (which git never
#      tracks or syncs across clones).
#   2. Point git at it once per clone:
#        git config core.hooksPath tools/git-hooks
#   3. Make it executable (matters on macOS/Linux/WSL; harmless on Windows):
#        chmod +x tools/git-hooks/pre-push
#
# This hook only prompts when you're pushing the master branch - pushes of
# feature branches go straight through with no prompt.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PUBSPEC="$REPO_ROOT/pubspec.yaml"
VERSION_DART="$REPO_ROOT/lib/config/version.dart"

# --- only act on pushes that include master ----------------------------------
pushing_main=false
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/master" ]]; then
    pushing_main=true
  fi
done

if [[ "$pushing_main" != true ]]; then
  exit 0
fi

# --- GUI helpers (Windows via powershell.exe) -------------------------------
# Every call is its own short-lived PowerShell process showing one native
# dialog. Empty stdout from an input box means the user hit Cancel.

gui_confirm() {
  # $1 = message, $2 = title. Returns 0 for Yes, 1 for No/Cancel.
  local message="$1" title="$2"
  local result
  result=$(powershell.exe -NoProfile -Command "
    Add-Type -AssemblyName System.Windows.Forms
    \$r = [System.Windows.Forms.MessageBox]::Show('$message', '$title', 'YesNo', 'Question')
    Write-Output \$r
  " | tr -d '\r\n')
  [[ "$result" == "Yes" ]]
}

gui_input() {
  # $1 = prompt, $2 = title, $3 = default value. Prints the entered value
  # (or the default if Cancel/empty) to stdout.
  local prompt="$1" title="$2" default="$3"
  powershell.exe -NoProfile -Command "
    Add-Type -AssemblyName Microsoft.VisualBasic
    [Microsoft.VisualBasic.Interaction]::InputBox('$prompt', '$title', '$default')
  " | tr -d '\r\n'
}

gui_error() {
  local message="$1"
  powershell.exe -NoProfile -Command "
    Add-Type -AssemblyName System.Windows.Forms
    [System.Windows.Forms.MessageBox]::Show('$message', 'Release tag error', 'OK', 'Error') | Out-Null
  " >/dev/null
}

# --- read current version state --------------------------------------------
current_pubspec_version=$(grep -E '^version:' "$PUBSPEC" | sed -E 's/^version:\s*//' | tr -d '\r')
# e.g. 1.0.0-beta.4+1 -> base=1.0.0  beta_num=4
base_version=$(echo "$current_pubspec_version" | sed -E 's/-beta\.[0-9]+\+[0-9]+$//')
current_beta_num=$(echo "$current_pubspec_version" | sed -E 's/^.*-beta\.([0-9]+)\+.*$/\1/')

current_build_number=$(grep -E 'static const int buildNumber' "$VERSION_DART" | sed -E 's/[^0-9]*([0-9]+).*/\1/')

next_beta_num=$((current_beta_num + 1))
next_build_number=$((current_build_number + 1))
suggested_version="${base_version}-beta.${next_beta_num}"
suggested_tag="v${suggested_version}"

# --- ask whether to cut a release at all ------------------------------------
if ! gui_confirm "Pushing to master.$'\n\n'Create a new beta release tag for this push?$'\n\n'Suggested: ${suggested_tag} (build #${next_build_number})" "Beta release"; then
  exit 0
fi

# --- ask for the tag name (editable, pre-filled with the suggestion) -------
tag_name=$(gui_input "Tag name (format: vX.Y.Z-beta.N)" "Beta release - tag" "$suggested_tag")

if [[ -z "$tag_name" ]]; then
  echo "pre-push: no tag name entered, aborting release (branch push cancelled too)." >&2
  exit 1
fi

if ! [[ "$tag_name" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-beta\.[0-9]+$ ]]; then
  gui_error "Tag '${tag_name}' doesn't match the required format vX.Y.Z-beta.N. Push aborted - nothing was changed."
  exit 1
fi

# --- refuse to touch an existing tag (matches your own roll-forward policy) -
if git rev-parse "$tag_name" >/dev/null 2>&1 || git ls-remote --exit-code --tags origin "$tag_name" >/dev/null 2>&1; then
  gui_error "Tag '${tag_name}' already exists (locally or on origin). Per the roll-forward policy in release_beta.md, tags are never reused - bump the beta number and try again. Push aborted, nothing was changed."
  exit 1
fi

# --- commit message ----------------------------------------------------------
new_version="${tag_name#v}"                          # e.g. 1.0.0-beta.5
new_beta_label=$(echo "$new_version" | sed -E 's/^.*-(beta\.[0-9]+)$/\1/')  # beta.5
default_message="chore(release): beta ${new_version}"
commit_message=$(gui_input "Commit + tag message" "Beta release - message" "$default_message")
if [[ -z "$commit_message" ]]; then
  commit_message="$default_message"
fi

# --- apply version bump -----------------------------------------------------
sed -i -E "s/^version:.*/version: ${new_version}+${next_build_number}/" "$PUBSPEC"
sed -i -E "s/(static const String preRelease = ')[^']*(';)/\1${new_beta_label}\2/" "$VERSION_DART"
sed -i -E "s/(static const int buildNumber = )[0-9]+;/\1${next_build_number};/" "$VERSION_DART"

git add "$PUBSPEC" "$VERSION_DART"
git commit -m "$commit_message"

git tag -a "$tag_name" -m "$commit_message"
git push origin "$tag_name"

echo "pre-push: created and pushed ${tag_name} (build #${next_build_number}). Continuing with your original push..." >&2

# NON-WINDOWS FALLBACK:
# Replace gui_confirm/gui_input/gui_error's powershell.exe bodies with:
#   zenity --question / --entry / --error   (Linux)
#   osascript -e 'display dialog ...'        (macOS)
# The rest of the script (version parsing, git commands) is unchanged.

exit 0
